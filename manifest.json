{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "Reading List Auto Summary",
  "description": "Automatically mark old entries as read in Chrome Reading List and generate AI-powered summaries before archiving.",
  "icons": {
    "16": "images/icons/icon16.png",
    "32": "images/icons/icon32.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "options_page": "src/frontend/options/options.html",
  "background": {
    "service_worker": "src/backend/background.js",
    "type": "module"
  },
  "permissions": ["storage", "readingList", "alarms"],
  "host_permissions": ["https://hooks.slack.com/*", "https://*/*", "http://*/*"]
}
