{
  "name": "reading-list-auto-summary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "build:release": "vite build && cd dist && zip -r ../readling-list-auto-summary.zip .",
    "preview": "vite preview",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "biome:ci": "biome ci .",
    "test": "vitest --silent",
    "test:ci": "vitest --silent --run --coverage",
    "check:ai": "pnpm type-check && pnpm biome:fix && pnpm test --run --reporter=dot && pnpm build"
  },
  "author": "kesin1202000@gmail.com",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@preact/preset-vite": "2.10.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.2",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@mizchi/readability": "^0.7.7",
    "openai": "^6.48.0",
    "preact": "^10.29.7",
    "unpdf": "^1.6.2"
  }
}
